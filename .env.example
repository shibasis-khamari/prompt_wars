# MongoDB Database Configuration (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=bughunt_arena

# Session Security Secret (Required)
SESSION_SECRET=your_random_session_secret_key_here

# Google Gemini API Key (Required for on-demand dynamic puzzle generation)
GEMINI_API_KEY=your_gemini_api_key_here

# On-Demand Generation Limits & Rate Limiting
GENERATION_USER_DAILY_CAP=20
GENERATION_GLOBAL_DAILY_CAP=100
GENERATION_IP_RATE_LIMIT=5

# Server Runtime Settings
PORT=3000
NODE_ENV=development

# Judge0 Execution Service (Optional fallback execution)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here
